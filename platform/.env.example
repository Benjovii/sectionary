# Platform (Lane B). Copy to platform/.env, never commit it.

# Postgres (Supabase). Use the pooler connection string.
DATABASE_URL=

# AI tagging (SEC-12). A key with a monthly spend cap.
ANTHROPIC_API_KEY=

# Object storage for block images (SEC-9), S3-compatible (Cloudflare R2 or DigitalOcean Spaces).
# The importer reads only S3_PUBLIC_BASE_URL; keep it equal to the root .env's, which the image pipeline uploads with.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Semantic search (SEC-17). Voyage embeddings of block descriptions; npm run embed.
VOYAGE_API_KEY=
# Must match the web app's VOYAGE_MODEL. Default voyage-3.5 (1024 dimensions).
# VOYAGE_MODEL=
