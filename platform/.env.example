# Platform (Lane B). Copy to platform/.env, never commit it.

# Postgres (Supabase). Use the pooler connection string.
DATABASE_URL=

# AI tagging (SEC-12). A key with a monthly spend cap.
ANTHROPIC_API_KEY=

# AI tagger (SEC-12): npm run tag-blocks. Model ids come from here, not the code.
# TAGGER_MODEL=sonnet            # sonnet (default) | haiku | any model id
# TAGGER_SONNET_MODEL=claude-sonnet-5-5
# TAGGER_HAIKU_MODEL=claude-haiku-4-5
# Cost cap in USD per run label: spent + in flight + new must stay under it, or submission stops.
# TAGGER_MAX_COST_USD=150
# TAGGER_EVAL_MAX_COST_USD=5
# Prices for a model the tagger does not know (USD per million tokens, standard rate; batches bill half).
# TAGGER_PRICE_INPUT=
# TAGGER_PRICE_OUTPUT=
# Screenshots are read from the bucket with the S3_* keys below; without them, from this base URL.
# TAGGER_IMAGE_BASE_URL=
# TAGGER_BATCH_SIZE=2000
# TAGGER_EXPECTED_OUTPUT_TOKENS=300
# TAGGER_POLL_SECONDS=60

# Object storage for block images (SEC-9), S3-compatible (Cloudflare R2 or DigitalOcean Spaces).
# The tagger reads screenshots from the bucket with all five. The importer reads only S3_PUBLIC_BASE_URL;
# keep it equal to the root .env's, which the image pipeline uploads with.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true   # for MinIO or another local S3

# Semantic search (SEC-17). Voyage embeddings of block descriptions; npm run embed.
VOYAGE_API_KEY=
# Must match the web app's VOYAGE_MODEL. Default voyage-3.5 (1024 dimensions).
# VOYAGE_MODEL=
