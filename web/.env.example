# Web app. Copy to web/.env.local. All optional: a fresh clone works without it.

# Data source. Default is the committed sample JSON, which keeps local
# development working with no database. Staging (SEC-47) sets all three, plus
# DATABASE_URL below, and leaves NEXT_PUBLIC_MOCK_BLOCKS unset: the app then
# queries the API page by page instead of loading a file. NEXT_PUBLIC_* values
# are baked in at build time, so redeploy after changing them.
# NEXT_PUBLIC_BLOCKS_SRC=/api/blocks
# NEXT_PUBLIC_STORES_SRC=/api/stores
# NEXT_PUBLIC_SITES_SRC=/api/sites

# Scale fixture (SEC-46). Multiplies the committed 84-block sample across the
# 1,005 validated stores in the browser, so the wall's virtualisation and the
# filters can be tested at the size we expect after the full capture. Nothing
# extra is downloaded. Leave it unset for the normal 84-block sample.
# NEXT_PUBLIC_MOCK_BLOCKS=30000

# Where block screenshots load from. Default in development is the deployed
# site. Set it empty to use images you captured and exported locally.
# NEXT_PUBLIC_ASSET_BASE=
# Server-only Supabase pooler URL used by /api/blocks, /api/stores and /api/sites/[host].
DATABASE_URL=
