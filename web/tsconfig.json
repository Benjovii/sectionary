{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // lib/mock-blocks, lib/block-source, lib/colour and lib/wall-layout are run
    // directly by scripts/mock-blocks.mjs under Node's type stripping, and Node
    // needs the extension on a relative import. Safe with noEmit.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // search-acceptance.mts loads platform/src/local-db.ts, which needs platform's
  // packages (PGlite); the web project and its CI job do not install them. Node
  // runs that script directly (npm run search:acceptance), so it is not type-checked here.
  "exclude": ["node_modules", "scripts/search-acceptance.mts"]
}
