{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // lib/mock-blocks, lib/block-source, lib/colour and lib/wall-layout are run
    // directly by scripts/mock-blocks.mjs under Node's type stripping, and Node
    // needs the extension on a relative import. Safe with noEmit.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // Files that import from outside web/ cannot be type-checked here: a production
  // deploy (vercel deploy from web/) uploads web/ alone, so `next build` fails on them.
  // - scripts/search-acceptance.mts loads platform/src/local-db.ts (and platform's
  //   PGlite packages); node runs it directly (npm run search:acceptance).
  // - src/server/search-intent.test.ts checks the intents against
  //   platform/src/taxonomy.ts; run it from the repo: npx tsx --test src/server/*.test.ts
  "exclude": ["node_modules", "scripts/search-acceptance.mts", "src/server/search-intent.test.ts"]
}
