# Crawler (Lane A). Copy to .env, never commit .env.

# Firecrawl search, used by the harvester's "search" source only. Optional.
FIRECRAWL_API_KEY=

# Object storage for block images (SEC-9), S3-compatible (Cloudflare R2 or
# DigitalOcean Spaces). Read by `npm run image-process`, which stops if any is
# missing. Use the same values as platform/.env, so the keys the importer
# records match what was uploaded.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true   # for MinIO or another local S3
# Screenshots taller than WebP's 16,383px limit are cut into slices of this height
# (at most 16383), listed in order in each page's images.json. Default 8192.
# IMAGE_SLICE_HEIGHT=8192

# Public page that explains the bot and how to opt out. Appended to the bot's
# user agent once the real domain exists (docs/bot-page.md has the copy).
SECTIONARY_BOT_URL=
